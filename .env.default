# Default values for local configuration and CI.
# Copy to .env only when you need machine-specific overrides.
# Never commit secrets or signing keystores.

# Tool locations (absolute paths are recommended when not on PATH)
GRADLE=gradle
ADB=adb
ANDROID_SDK_ROOT=/absolute/path/to/Android/Sdk
ANDROID_HOME=/absolute/path/to/Android/Sdk

VERSION_NAME=0.8.4

# Optional serial from "make devices". Leave blank for ADB default selection.
ADB_SERIAL=

# Release signing. Path is relative to the repository root unless absolute.
RELEASE_KEYSTORE_PATH=keystore/release.jks
ANDROID_KEYSTORE_PASSWORD=change-me
ANDROID_KEY_ALIAS=change-me
ANDROID_KEY_PASSWORD=change-me
