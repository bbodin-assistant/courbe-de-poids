<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8FAFC">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/app_name" android:textColor="#0F172A" android:textSize="22sp" android:textStyle="bold"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
<TextView android:id="@+id/today_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#64748B" android:textSize="15sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="#FFFFFF" android:elevation="2dp" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Évolution du poids" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold"/>
<fr.bbodin.courbedepoids.WeightChartView android:id="@+id/weight_chart" android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="12dp"/>
</LinearLayout></LinearLayout>
</ScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="#FFFFFF" android:elevation="12dp" android:gravity="center" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
<ImageButton android:id="@+id/add_past_button" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Ajouter une mesure passée" android:src="@drawable/ic_calendar"/>
<ImageButton android:id="@+id/history_button" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Historique" android:src="@drawable/ic_history"/>
<ImageButton android:id="@+id/save_today" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_fab" android:contentDescription="Enregistrer le poids du jour" android:elevation="6dp" android:padding="15dp" android:src="@drawable/ic_add" android:tint="#FFFFFF"/>
<ImageButton android:id="@+id/settings_button" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Paramètres" android:src="@drawable/ic_settings"/>
</LinearLayout>
</LinearLayout></FrameLayout>