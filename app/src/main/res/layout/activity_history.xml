<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="#F3F7FC" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:background="#147BEF" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Historique" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Toutes vos mesures enregistrées" android:textSize="13sp" android:textColor="#EAF4FF"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="12dp">
        <LinearLayout android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp"/>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation"/>
</LinearLayout>
