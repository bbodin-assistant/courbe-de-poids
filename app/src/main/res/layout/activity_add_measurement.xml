<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F3F7FC" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:background="#147BEF" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ajouter" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Poids et hydratation" android:textSize="13sp" android:textColor="#EAF4FF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="#F3F7FC">
        <LinearLayout android:id="@+id/weight_mode_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_primary_button" android:clickable="true" android:focusable="true" android:contentDescription="Ajouter le poids">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_scale" android:contentDescription="@null" android:tint="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="Poids" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/water_mode_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_input" android:clickable="true" android:focusable="true" android:contentDescription="Ajouter de l'eau">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_water" android:contentDescription="@null" android:tint="#147BEF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="Eau" android:textColor="#14243A" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/sport_mode_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_input" android:clickable="true" android:focusable="true" android:contentDescription="Ajouter une activité sportive">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_sport" android:contentDescription="@null" android:tint="#147BEF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Sport" android:textColor="#14243A" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="8dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/date_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Date" android:textSize="14sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/date_input" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="16sp" android:textColor="#14243A" android:drawableEnd="@drawable/ic_calendar" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/weight_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Poids (kg)" android:textSize="14sp" android:textColor="#64748B"/>
                <EditText android:id="@+id/weight_input" android:layout_width="match_parent" android:layout_height="112dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:gravity="center" android:hint="0,0" android:inputType="numberDecimal" android:textSize="44sp" android:textStyle="bold" android:textColor="#14243A" android:padding="12dp"/>
                <Button android:id="@+id/save_measurement" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="22dp" android:background="@drawable/bg_primary_button" android:text="Enregistrer le poids" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/water_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quelle quantité d'eau avez-vous bue ?" android:textSize="17sp" android:textStyle="bold" android:textColor="#14243A"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Touchez un verre pour enregistrer cette quantité." android:textSize="13sp" android:textColor="#64748B"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center">
                    <LinearLayout android:id="@+id/water_250" android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_input" android:clickable="true" android:focusable="true" android:contentDescription="Ajouter 250 millilitres d'eau">
                        <ImageView android:layout_width="40dp" android:layout_height="46dp" android:src="@drawable/ic_water" android:contentDescription="@null"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="25 cl" android:textColor="#14243A" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/water_330" android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_input" android:clickable="true" android:focusable="true" android:contentDescription="Ajouter 330 millilitres d'eau">
                        <ImageView android:layout_width="40dp" android:layout_height="46dp" android:src="@drawable/ic_water" android:contentDescription="@null"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="33 cl" android:textColor="#14243A" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/water_500" android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_input" android:clickable="true" android:focusable="true" android:contentDescription="Ajouter 500 millilitres d'eau">
                        <ImageView android:layout_width="40dp" android:layout_height="46dp" android:src="@drawable/ic_water" android:contentDescription="@null"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="500 ml" android:textColor="#14243A" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Quantité personnalisée (ml)" android:textSize="14sp" android:textColor="#64748B"/>
                <EditText android:id="@+id/water_custom_input" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Ex. 200" android:inputType="number" android:textSize="18sp" android:textColor="#14243A"/>
                <Button android:id="@+id/save_custom_water" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_primary_button" android:text="Enregistrer la quantité" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/sport_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Activité sportive" android:textSize="18sp" android:textStyle="bold" android:textColor="#14243A"/>
                <RadioGroup android:id="@+id/sport_type_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                    <RadioButton android:id="@+id/sport_type_yoga" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Yoga" android:textColor="#14243A"/>
                    <RadioButton android:id="@+id/sport_type_run" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Course" android:textColor="#14243A"/>
                    <RadioButton android:id="@+id/sport_type_climb" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Escalade" android:textColor="#14243A"/>
                    <RadioButton android:id="@+id/sport_type_workout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Workout" android:textColor="#14243A"/>
                </RadioGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Durée (minutes)" android:textColor="#64748B" android:textSize="14sp"/>
                <EditText android:id="@+id/sport_duration_input" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Ex. 45" android:inputType="number" android:textSize="18sp" android:textColor="#14243A"/>
                <TextView android:id="@+id/sport_distance_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Distance (km, facultative)" android:textColor="#64748B" android:textSize="14sp" android:visibility="gone"/>
                <EditText android:id="@+id/sport_distance_input" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Ex. 5,2" android:inputType="numberDecimal" android:textSize="18sp" android:textColor="#14243A" android:visibility="gone"/>
                <Button android:id="@+id/save_sport" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/bg_primary_button" android:text="Enregistrer le sport" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
