<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F3F7FC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:background="#147BEF" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ajouter une mesure" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enregistrez votre poids du jour" android:textSize="13sp" android:textColor="#EAF4FF"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="18dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:elevation="2dp" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/date_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Date de la mesure" android:textSize="14sp" android:textColor="#64748B"/>
                <TextView android:id="@+id/date_input" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="16sp" android:textColor="#14243A" android:drawableEnd="@drawable/ic_calendar" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/date_today_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Aujourd'hui" android:textSize="13sp" android:textColor="#147BEF"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Poids (kg)" android:textSize="14sp" android:textColor="#64748B"/>
                <EditText android:id="@+id/weight_input" android:layout_width="match_parent" android:layout_height="112dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:gravity="center" android:hint="0,0" android:inputType="numberDecimal" android:textSize="44sp" android:textStyle="bold" android:textColor="#14243A" android:padding="12dp"/>
                <Button android:id="@+id/save_measurement" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="22dp" android:background="@drawable/bg_primary_button" android:text="Enregistrer la mesure" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="#FFFFFF" android:elevation="10dp" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/home_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Accueil" android:padding="22dp" android:src="@drawable/ic_history" android:tint="#64748B"/>
        <ImageButton android:id="@+id/add_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Ajouter une mesure" android:padding="22dp" android:src="@drawable/ic_add" android:tint="#147BEF"/>
        <ImageButton android:id="@+id/history_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Historique" android:padding="22dp" android:src="@drawable/ic_history" android:tint="#64748B"/>
        <ImageButton android:id="@+id/settings_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Paramètres" android:padding="22dp" android:src="@drawable/ic_settings" android:tint="#64748B"/>
    </LinearLayout>
</LinearLayout>